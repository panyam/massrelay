# Domain for TLS (Caddy auto-provisions Let's Encrypt cert)
# Use "localhost" for local testing (Caddy serves self-signed)
RELAY_DOMAIN=r01.example.com

# OTEL service name — use a unique name per relay for pool identification
OTEL_SERVICE_NAME=massrelay-r01

# OTLP collector endpoint (leave empty to disable remote export)
# Example: https://otlp-gateway-prod-us-east-0.grafana.net/otlp
OTEL_EXPORTER_OTLP_ENDPOINT=

# Log first N chars of message payloads for debugging (0 = disabled)
RELAY_LOG_PAYLOADS=0

# Admin API bearer token (required to enable /admin/* endpoints)
# Generate one with: openssl rand -hex 32
RELAY_ADMIN_TOKEN=

# Security (optional, recommended for production)
# Comma-separated origin allowlist for WebSocket + CORS (empty = allow all)
RELAY_ALLOWED_ORIGINS=
# Comma-separated trusted proxy CIDRs for X-Forwarded-For (empty = trust all)
RELAY_TRUSTED_PROXIES=
# Max concurrent WebSocket connections (0 = unlimited)
RELAY_MAX_CONNECTIONS=500
# Rate limits (connections/sec)
RELAY_GLOBAL_RATE=100
RELAY_PER_IP_RATE=5
# Connections one IP may open at once, e.g. a browser restoring several tabs
# (empty = max(3, RELAY_PER_IP_RATE))
RELAY_PER_IP_BURST=
# Per-subject rate limit (requires auth, 0 = disabled)
RELAY_PER_SUB_RATE=0

# JWT auth on the WebSocket upgrade (see README "Authentication")
# true = reject connections without a valid token. The relay refuses to start
# with true and no keys, rather than accepting everyone.
RELAY_AUTH_REQUIRED=false
# Expected JWT iss claim (empty = any)
RELAY_AUTH_ISSUER=
# Signing keys: set ONE of these.
# A JSON array of {"client_id","alg","key"}; put it in ./secrets/, which is
# mounted at /etc/massrelay, e.g. /etc/massrelay/keys.json
RELAY_AUTH_KEYS_FILE=
# Or a JWKS endpoint, e.g. https://auth.example.com/.well-known/jwks.json
RELAY_AUTH_JWKS_URL=

# Protected Resource Metadata (RFC 9728)
# Both RELAY_RESOURCE_URL and RELAY_AUTH_SERVERS are required to enable PRM.
# Serves /.well-known/oauth-protected-resource for client auto-discovery.
RELAY_RESOURCE_URL=
RELAY_AUTH_SERVERS=
